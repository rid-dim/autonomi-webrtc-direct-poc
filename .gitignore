# Build output
target/
web/dist/
node_modules/

# Generated by the build: wasm-bindgen output for the `web` and `nodejs` targets.
# Reproduced by `npm run build` / `npm run build:wasm-node`.
crates/wasm-client/pkg/
web/src/wasm/
web/src/wasm-node/

# Test and demo fixtures. Generated on demand — the integration suite writes
# what it needs, so nothing here has to be checked in.
/fixtures/

# Proxy runtime state. The identity keypair and DTLS certificate are secrets,
# they are machine-specific, and regenerating them changes the multiaddr that
# clients have hard-coded — so they must never be committed.
.proxy-state/
.proxy-state-test-*/
proxy-identity/

# Belt and braces against key material landing anywhere else.
*.pem
*.key

# The vendored crates' example programs, which ship test certificates and
# private keys. Nothing here is needed to build the library, and publishing key
# material — even the throwaway kind — is not worth the noise it causes in
# secret scanners. vendor/README.md notes the omission.
vendor/**/examples/

# Local scratch
*.log
.DS_Store
